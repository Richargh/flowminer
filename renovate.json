{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": ["trunk"],
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "ignoreDeps": ["flowminer-git-importer", "flowminer-shared"],
  "packageRules": [
    {
      "groupName": "kotlin-core",
      "matchPackagePatterns": [
        "^org\\.jetbrains\\.kotlin",
        "^org\\.jetbrains\\.kotlinx",
        "^com\\.google\\.devtools\\.ksp"
      ]
    },
    {
      "groupName": "ktor",
      "matchPackagePatterns": ["^io\\.ktor"]
    },
    {
      "groupName": "jackson",
      "matchPackagePatterns": ["^com\\.fasterxml\\.jackson"]
    },
    {
      "groupName": "gradle-testing",
      "matchPackagePatterns": [
        "^org\\.junit",
        "^io\\.kotest",
        "^de\\.infix\\.testBalloon"
      ]
    },
    {
      "groupName": "node-testing",
      "matchPackageNames": ["vitest", "playwright", "axe-core", "vitest-axe"],
      "matchPackagePatterns": ["^@vitest/"]
    },
    {
      "groupName": "lit",
      "matchPackageNames": ["lit"],
      "matchPackagePatterns": ["^@lit/"]
    },
    {
      "groupName": "vite",
      "matchPackageNames": ["vite"],
      "matchPackagePatterns": ["^@vitejs/"]
    },
    {
      "groupName": "tailwind-ui",
      "matchPackageNames": ["tailwindcss", "daisyui"],
      "matchPackagePatterns": ["^@tailwindcss/"]
    }
  ]
}
